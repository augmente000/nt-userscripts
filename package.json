{
    "name": "nt-userscripts",
    "version": "1.0.0",
    "description": "Collection of userscripts for various purposes",
    "keywords": [
        "improvements",
        "nt",
        "ui",
        "userscripts"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/augmente000/nt-userscripts.git"
    },
    "type": "module",
    "scripts": {
        "build": "node --strip-types src/build/build.ts",
        "build:watch": "node --strip-types src/build/build.ts --watch",
        "start": "pnpm run build:watch",
        "bump-versions": "node --strip-types src/build/bump-versions-if-changed.ts",
        "type-check": "tsc",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "pnpm run oxlint",
        "oxlint": "oxlint --type-aware"
    },
    "devDependencies": {
        "@babel/core": "^8.0.9",
        "@babel/preset-env": "^8.0.7",
        "@babel/preset-typescript": "^8.0.7",
        "@rollup/plugin-alias": "^6.0.1",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@types/greasemonkey": "^4.0.7",
        "@types/node": "^24.19.2",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^0.25.0",
        "rollup": "^4.65.1",
        "typescript": "^7.0.2",
        "zod": "^4.6.7"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.x",
            "onFail": "warn"
        }
    },
    "engines": {
        "node": "24.x"
    },
    "packageManager": "pnpm@12.15.0"
}
